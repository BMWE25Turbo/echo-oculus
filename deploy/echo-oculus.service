[Unit]
Description=Echo Oculus core service
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/echo-oculus
ExecStart=%h/echo-oculus/venv/bin/python -u main.py
Restart=always
RestartSec=5
User=%i
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
